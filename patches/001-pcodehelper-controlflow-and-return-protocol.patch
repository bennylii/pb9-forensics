+		private static bool IsSimpleStatement(string s)
+		{
+			if (string.IsNullOrWhiteSpace(s))
+			{
+				return false;
+			}
+			string text = s.Trim().ToLowerInvariant();
+			string[] array = new string[15] { "if ", "for ", "next ", "do ", "loop ", "choose ", "case ", "else", "end ", "try ", "catch ", "finally ", "goto ", "select ", "declare " };
+			foreach (string text2 in array)
+			{
+				if (text.StartsWith(text2))
+				{
+					return false;
+				}
+			}
+			return true;
+		}
