+		private static void ParseIfMerge(Dictionary<ushort, CodeLine> list)
+		{
+			// 编译器把复合条件拆成顺序条件跳转:
+			//   `if A and B`  => [JmpIfFalse(A)→T][JmpIfFalse(B)→T] 同目标相邻对
+			//   `if A or B`   => [JmpIfTrue(A)→X][JmpIfFalse(B)→E] 真跳目标=紧随下一非空行
+			// 还原为单个 if; 循环到不动点支持任意项数
+			List<CodeLine> ordered = new List<CodeLine>(list.Values);
+			bool flag2 = true;
+			while (flag2)
+			{
+				flag2 = false;
+				// 预生成下一非空行位置
+				Dictionary<CodeLine, ushort> nextNonBlank = new Dictionary<CodeLine, ushort>();
+				for (int i = 0; i < ordered.Count; i++)
+				{
+					if (string.IsNullOrEmpty(ordered[i].SCode))
+					{
+						continue;
+					}
+					for (int j = i + 1; j < ordered.Count; j++)
+					{
+						if (!string.IsNullOrEmpty(ordered[j].SCode))
+						{
+							nextNonBlank[ordered[i]] = ordered[j].PCodePositon;
+							break;
+						}
+					}
+				}
+				CodeLine codeLine = null;
+				foreach (CodeLine value in list.Values)
+				{
+					if (string.IsNullOrEmpty(value.SCode))
+					{
+						continue;
+					}
+					if (codeLine != null && codeLine.JmpType == JmpType.JmpIfFalse && value.JmpType == JmpType.JmpIfFalse && codeLine.JmpPositon > codeLine.PCodePositon && value.JmpPositon > value.PCodePositon && codeLine.JmpPositon == value.JmpPositon)
+					{
+						value.Condition = string.Format("({0}) and ({1})", codeLine.Condition, value.Condition);
+						codeLine.SCode = "";
+						codeLine.JmpType = JmpType.None;
+						codeLine.Condition = null;
+						flag2 = true;
+						codeLine = null;
+						continue;
+					}
+					if (codeLine != null && codeLine.JmpType == JmpType.JmpIfTrue && value.JmpType == JmpType.JmpIfFalse && codeLine.JmpPositon > codeLine.PCodePositon && value.JmpPositon > value.PCodePositon && nextNonBlank.ContainsKey(value) && codeLine.JmpPositon == nextNonBlank[value])
+					{
+						value.Condition = string.Format("{0} or {1}", codeLine.Condition, value.Condition);
+						codeLine.SCode = "";
+						codeLine.JmpType = JmpType.None;
+						codeLine.Condition = null;
+						flag2 = true;
+						codeLine = null;
+						continue;
+					}
+					codeLine = value;
 				}
 			}
 		}
