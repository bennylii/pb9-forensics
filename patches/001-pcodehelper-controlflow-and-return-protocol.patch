+		private static void ParseGoto(Dictionary<ushort, CodeLine> list, List<CodeArea> areas)
+		{
+			// 此时 for/do/choose/if 均已结构化; 残余跳转 = 常真条件环(do while true)、
+			// 环内 continue/exit、源码真 goto。配对实测定案见 docs/22。
+			List<CodeLine> ordered = new List<CodeLine>(list.Values);
+			Dictionary<ushort, int> idx = new Dictionary<ushort, int>();
+			for (int i = 0; i < ordered.Count; i++)
+			{
+				idx[ordered[i].PCodePositon] = i;
+			}
+			// pass 1: do-while-true 型环 — backward Jmp(回边) + 环体内 forward Jmp 落回边后继(=exit)
+			for (int i = 0; i < ordered.Count; i++)
+			{
+				CodeLine codeLine = ordered[i];
+				if (string.IsNullOrEmpty(codeLine.SCode) || codeLine.JmpType != JmpType.Jmp || codeLine.JmpPositon >= codeLine.PCodePositon)
+				{
+					continue;
+				}
+				int num;
+				if (!idx.TryGetValue(codeLine.JmpPositon, out num) || num >= i)
+				{
+					continue;
+				}
+				ushort afterLoop = (ushort)((i + 1 < ordered.Count) ? ordered[i + 1].PCodePositon : 0);
+				if (afterLoop == 0)
+				{
+					continue;
+				}
+				bool hasExit = false;
+				for (int j = num; j < i; j++)
+				{
+					CodeLine codeLine2 = ordered[j];
+					if (!string.IsNullOrEmpty(codeLine2.SCode) && codeLine2.JmpType == JmpType.Jmp && codeLine2.JmpPositon == afterLoop)
+					{
+						hasExit = true;
+						break;
+					}
+				}
+				if (!hasExit)
+				{
+					continue;
+				}
+				ordered[num].LabelSCode.Add("do while true ");
+				codeLine.SCode = "loop ";
+				codeLine.JmpType = JmpType.None;
+				for (int j = num; j < i; j++)
+				{
+					CodeLine codeLine2 = ordered[j];
+					if (!string.IsNullOrEmpty(codeLine2.SCode) && codeLine2.JmpType == JmpType.Jmp && codeLine2.JmpPositon == afterLoop)
+					{
+						codeLine2.SCode = "exit";
+						codeLine2.JmpType = JmpType.None;
+					}
+				}
+			}
+			// pass 2: 残余跳转分类
+			foreach (CodeLine value in list.Values)
+			{
+				if (string.IsNullOrEmpty(value.SCode) || value.JmpType == JmpType.None)
+				{
+					continue;
+				}
+				if (value.JmpType == JmpType.Jmp && value.JmpPositon < value.PCodePositon)
+				{
+					// backward Jmp 目标为环头 => continue (PB 的 continue 在 do 环中即回跳)
+					CodeLine codeLine3 = list[value.JmpPositon];
+					bool flag = codeLine3.LabelSCode.Any((string l) => l.Trim().StartsWith("do")) || areas.Any((CodeArea a) => a.Start == codeLine3.PCodePositon);
+					if (flag)
+					{
+						value.SCode = "continue";
+						value.JmpType = JmpType.None;
+					}
+					continue;
+				}
+				if (value.JmpType == JmpType.JmpIfTrue && value.JmpPositon > value.PCodePositon)
+				{
+					// forward 条件真跳: 落在环末 => if COND then exit/continue (PB: if x then exit)
+					CodeArea codeArea = FindInnermostArea(areas, value.PCodePositon);
+					if (codeArea != null && value.PCodePositon >= codeArea.Start && value.PCodePositon <= codeArea.End)
+					{
+						if (list[value.JmpPositon].PreCodeLine.PCodePositon == codeArea.End)
+						{
+							value.SCode = string.Format("if {0} then exit", value.Condition);
+							value.JmpType = JmpType.None;
+						}
+						else if (list[value.JmpPositon].PCodePositon == codeArea.End)
+						{
+							value.SCode = string.Format("if {0} then continue", value.Condition);
+							value.JmpType = JmpType.None;
+						}
+					}
+				}
+			}
+		}
+
+		private static CodeArea FindInnermostArea(List<CodeArea> areas, int pos)
+		{
+			CodeArea codeArea = null;
+			foreach (CodeArea item in areas)
+			{
+				if (pos >= item.Start && pos <= item.End && (codeArea == null || item.End - item.Start < codeArea.End - codeArea.Start))
+				{
+					codeArea = item;
+				}
+			}
+			return codeArea;
+		}
